# Copy to .env and fill in. .env is gitignored.

# Champions League fixtures + results (ingest/champions_league.py).
# Free tier, register at https://www.football-data.org/client/register
# Without it, the CL block in scripts.predict_upcoming just skips itself.
FOOTBALL_DATA_ORG_TOKEN=

# API-Football (api-sports.io) - only used by scripts/check_injury_coverage.py,
# a one-off diagnostic. Not needed for the pipeline.
API_FOOTBALL_KEY=
